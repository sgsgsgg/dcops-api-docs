  "components": {
    "schemas": {
      "CommonRequestBase": {
        "type": "object",
        "required": ["Action", "Method", "SystemId"],
        "properties": {
          "Action": {
            "type": "string",
            "description": "操作类型，固定值"
          },
          "Method": {
            "type": "string",
            "description": "方法名称，固定值"
          },
          "SystemId": {
            "type": "string",
            "description": "调用方系统标识"
          }
        }
      },
      "QueryDataRequestBase": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonRequestBase"
          },
          {
            "type": "object",
            "required": ["SchemaId", "ReturnTotalRows", "Data"],
            "properties": {
              "SchemaId": {
                "type": "string",
                "description": "查询的表/Schema标识"
              },
              "ReturnTotalRows": {
                "type": "integer",
                "description": "是否返回总行数，0-不返回，1-返回"
              },
              "BussType": {
                "type": "string",
                "description": "业务类型"
              },
              "Data": {
                "type": "object",
                "properties": {
                  "ResultColumns": {
                    "type": "object",
                    "description": "需要返回的字段列表，字段值为空字符串"
                  },
                  "SearchCondition": {
                    "type": "object",
                    "description": "查询条件，支持精确查询、集合查询(IN)、范围查询(gt/gte/lt/lte)"
                  },
                  "Sorts": {
                    "type": "array",
                    "description": "排序规则",
                    "items": {
                      "type": "object",
                      "properties": {
                        "Column": {
                          "type": "string",
                          "description": "排序字段名"
                        },
                        "SortType": {
                          "type": "string",
                          "enum": ["asc", "desc"],
                          "description": "排序方式"
                        }
                      }
                    }
                  },
                  "Limit": {
                    "type": "object",
                    "properties": {
                      "Size": {
                        "type": "integer",
                        "description": "每页记录数"
                      },
                      "Start": {
                        "type": "integer",
                        "description": "起始位置"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "Return": {
            "type": "integer",
            "description": "返回码，0表示成功"
          },
          "Details": {
            "type": "string",
            "description": "详细信息"
          },
          "ReqId": {
            "type": "string",
            "description": "请求ID"
          },
          "Data": {
            "type": "object",
            "description": "返回数据"
          }
        }
      },
      "InspectionMainQueryRequest": {
        "$ref": "#/components/schemas/QueryDataRequestBase"
      },
      "InspectionMainQueryResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "Data": {
                "type": "object",
                "properties": {
                  "List": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "description": "巡检主表记录"
                    }
                  },
                  "TotalRows": {
                    "type": "integer",
                    "description": "总行数"
                  }
                }
              }
            }
          }
        ]
      },
      "MaintenanceMainQueryRequest": {
        "$ref": "#/components/schemas/QueryDataRequestBase"
      },
      "MaintenanceMainQueryResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "Data": {
                "type": "object",
                "properties": {
                  "List": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
