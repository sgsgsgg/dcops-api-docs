                "example": {
                  "Return": 0,
                  "Details": "",
                  "ReqId": "fob-gnetopsd0nyg51pfngg",
                  "Data": {
                    "List": [
                      {
                        "Id": 123,
                        "TaskName": "仪征东升模组11_日常巡检_2023-05-11 18:00:06",
                        "TicketId": "20230511002045",
                        "UpdateTime": "2024-02-20 17:07:33"
                      }
                    ],
                    "TotalRows": 1078
                  }
                }
              }
            }
          }
        }
      }
    },
